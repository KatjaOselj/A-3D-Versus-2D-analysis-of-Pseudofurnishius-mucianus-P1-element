library(geomorph)
library(vegan)
library(ggplot2)
library(ggfortify)
library(dplyr)
library(car)
library(rgl)
library("plot3D")
# Import data ----
## 2D ----
landmarks2D <- readland.tps(file = "INPUT/2D.TPS", specID = "ID", readcurves = TRUE)
samples2D <- data.frame(name = rep(NA, dim(landmarks2D)[3]),
region = rep(NA, dim(landmarks2D)[3]),
country = rep(NA, dim(landmarks2D)[3]),
section = rep(NA, dim(landmarks2D)[3]),
layer = rep(NA, dim(landmarks2D)[3]),
chirality = rep(NA, dim(landmarks2D)[3]),
length = rep(NA, dim(landmarks2D)[3]))
for (i in 1:dim(landmarks2D)[3]) {
samples2D$name[i] <- dimnames(landmarks2D)[[3]][i]
samples2D$region[i] <- unlist(strsplit(samples2D$name[i], "_"))[1]
samples2D$country[i] <- unlist(strsplit(samples2D$name[i], "_"))[2]
samples2D$section[i] <- unlist(strsplit(samples2D$name[i], "_"))[3]
samples2D$layer[i] <- unlist(strsplit(samples2D$name[i], "_"))[4]
samples2D$chirality[i] <- unlist(strsplit(samples2D$name[i], "_"))[5]
samples2D$length[i] <- unlist(strsplit(samples2D$name[i], "_"))[6]
}
samples2D$region = case_when(samples2D$region == "NE" ~ "Northeastern", samples2D$region == "W"  ~ "Western")
samples2D$country = case_when(samples2D$country == "SL" ~ "Slovenia", samples2D$country == "SP"  ~ "Spain")
samples2D$section = case_when(samples2D$section == "PR" ~ "Prikrnica", samples2D$section == "BU"  ~ "Bugarra", samples2D$section == "LI"  ~ "Libros")
samples2D$chirality = case_when(samples2D$chirality == "L" ~ "sinistral", samples2D$chirality == "R"  ~ "dextral")
samples2D$region <- as.factor(samples2D$region)
samples2D$country <- as.factor(samples2D$country)
samples2D$section <- as.factor(samples2D$section)
samples2D$layer <- as.factor(samples2D$layer)
samples2D$chirality <- as.factor(samples2D$chirality)
samples2D$length <- as.numeric(samples2D$length)
## 2D_from3D ----
landmarks2D_from3D <- readland.tps(file = "INPUT/2D_from_3D.TPS", specID = "ID", readcurves = TRUE)
samples2D_from3D <- data.frame(name = rep(NA, dim(landmarks2D_from3D)[3]),
region = rep(NA, dim(landmarks2D_from3D)[3]),
country = rep(NA, dim(landmarks2D_from3D)[3]),
section = rep(NA, dim(landmarks2D_from3D)[3]),
layer = rep(NA, dim(landmarks2D_from3D)[3]),
chirality = rep(NA, dim(landmarks2D_from3D)[3]),
length = rep(NA, dim(landmarks2D_from3D)[3]))
for (i in 1:dim(landmarks2D_from3D)[3]) {
samples2D_from3D$name[i] <- dimnames(landmarks2D_from3D)[[3]][i]
samples2D_from3D$region[i] <- unlist(strsplit(samples2D_from3D$name[i], "_"))[1]
samples2D_from3D$country[i] <- unlist(strsplit(samples2D_from3D$name[i], "_"))[2]
samples2D_from3D$section[i] <- unlist(strsplit(samples2D_from3D$name[i], "_"))[3]
samples2D_from3D$layer[i] <- unlist(strsplit(samples2D_from3D$name[i], "_"))[4]
samples2D_from3D$chirality[i] <- unlist(strsplit(samples2D_from3D$name[i], "_"))[5]
samples2D_from3D$length[i] <- unlist(strsplit(samples2D_from3D$name[i], "_"))[6]
}
samples2D_from3D$region = case_when(samples2D_from3D$region == "NE" ~ "Northeastern", samples2D_from3D$region == "W"  ~ "Western")
samples2D_from3D$country = case_when(samples2D_from3D$country == "SL" ~ "Slovenia", samples2D_from3D$country == "SP"  ~ "Spain")
samples2D_from3D$section = case_when(samples2D_from3D$section == "PR" ~ "Prikrnica", samples2D_from3D$section == "BU"  ~ "Bugarra", samples2D_from3D$section == "LI"  ~ "Libros")
samples2D_from3D$chirality = case_when(samples2D_from3D$chirality == "L" ~ "sinistral", samples2D_from3D$chirality == "R"  ~ "dextral")
samples2D_from3D$region <- as.factor(samples2D_from3D$region)
samples2D_from3D$country <- as.factor(samples2D_from3D$country)
