## Function to determine the number of informative PCs using the Broken Stick Model ----
# After GUENSER et al., 2022
doPcaSignif <- function(eigvals) {
acron <- character()
criterion <- character()
nsigncomp <- numeric()
n <- length(eigvals)
# Percentage variance explained
pcvars <- 100 * eigvals / sum(eigvals)
# Broken stick model
bsm <- data.frame(j = seq_len(n), p = 0)
bsm$p[1] <- 1 / n
for(i in 2:n){
bsm$p[i] <- bsm$p[i - 1] + (1 / (n + 1 - i))
}
bsm$p <- 100 * bsm$p / n
bsvars <- rev(bsm$p)
acron <- "BSM"
criterion <- "Broken stick model"
nsigncomp <- sum(pcvars >= bsvars)
data.frame(acron, criterion, nsigncomp)
}
# Eigenvalues from your geomorph PCA 2D_from3D
pcasign_2D_from3D <- doPcaSignif(PCA_2D_from3D$d^2)
print(pcasign_2D_from3D)
# Plot Eigenvalues of first 20 PCs, to visualise
eigvals_all_2D_from3D <- (PCA_2D_from3D$d)^2
# Number of PCs to display
npcs_2D_from3D <- min(20, length(eigvals_all_2D_from3D))
eigvals_2D_from3D <- eigvals_all_2D_from3D[1:npcs_2D_from3D]
# % variance explained
pcvars_2D_from3D <- 100 * eigvals_2D_from3D / sum(eigvals_all_2D_from3D)
# Broken-stick expectations
n_2D_from3D <- length(eigvals_all_2D_from3D)
bsvars_all_2D_from3D <- sapply(1:n_2D_from3D, function(i) {
100 * sum(1/(i:n_2D_from3D))/n_2D_from3D
})
bsvars_2D_from3D <- bsvars_all_2D_from3D[1:npcs_2D_from3D]
# Plot
plot(pcvars_2D_from3D, type = "b", pch = 19,
xlab = "Principal Component",
ylab = "Variance explained (%)",
xlim = c(1, npcs_2D_from3D),
ylim = c(0, max(pcvars_2D_from3D, bsvars_2D_from3D) * 1.05),
main = "Scree Plot with Broken Stick Model")
lines(bsvars_2D_from3D, type = "b", pch = 16, col = "red", lwd = 2)
legend("topright",
legend = c("Observed", "Broken stick"),
fill = c(NA, NA),
border = c(NA, NA),
lty = c(1, 1),
pch = c(16, 16),
col = c("black", "red"))
