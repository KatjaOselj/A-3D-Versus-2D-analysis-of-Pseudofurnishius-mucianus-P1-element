## 2D vs 3Dsimp ----
protest(X = PCA_2D$x[,1:3], Y = PCA_3Dsimp$x[,1:3], permutations = 9999)
## 2D vs 3Dall ----
protest(X = PCA_2D$x[,1:3], Y = PCA_3Dall$x[,1:3], permutations = 9999)
## 2D vs 2D_from3D ----
protest(X = PCA_2D$x[,1:3], Y = PCA_2D_from3D$x[,1:3], permutations = 9999)
## 3Dsimp vs 3Dall ----
protest(X = PCA_3Dsimp$x[,1:3], Y = PCA_3Dall$x[,1:3], permutations = 9999)
## 3Dsimp vs 2D_from3D ----
protest(X = PCA_3Dsimp$x[,1:3], Y = PCA_2D_from3D$x[,1:3], permutations = 9999)
## 3Dall vs 2D_from3D ----
protest(X = PCA_3Dall$x[,1:3], Y = PCA_2D_from3D$x[,1:3], permutations = 9999)
# Number of PCs to test
k_values <- c(3, 4, 5, 10)
# Function to run PROTEST for different numbers of PCs
run_protest_sensitivity <- function(PCA1, PCA2, k_values, permutations = 9999) {
max_k <- min(ncol(PCA1$x), ncol(PCA2$x))
k_values <- k_values[k_values <= max_k]
results <- lapply(k_values, function(k) {
res <- protest(
X = PCA1$x[, 1:k, drop = FALSE],
Y = PCA2$x[, 1:k, drop = FALSE],
permutations = permutations
)
data.frame(
PCs = k,
correlation = res$t0,
p_value = res$signif
)
})
do.call(rbind, results)
}
res_2D_3Dsimp <- run_protest_sensitivity(
PCA_2D, PCA_3Dsimp, k_values = c(3, 4, 5, 10)
)
res_2D_3Dall <- run_protest_sensitivity(
PCA_2D, PCA_3Dall, k_values = c(3, 4, 5, 10)
)
res_2D_2Dfrom3D <- run_protest_sensitivity(
PCA_2D, PCA_2D_from3D, k_values = c(3, 4, 5, 10)
)
res_3Dsimp_3Dall <- run_protest_sensitivity(
PCA_3Dsimp, PCA_3Dall, k_values = c(3, 4, 5, 10)
)
res_3Dsimp_2Dfrom3D <- run_protest_sensitivity(
PCA_3Dsimp, PCA_2D_from3D, k_values = c(3, 4, 5, 10)
)
res_3Dall_2Dfrom3D <- run_protest_sensitivity(
PCA_3Dall, PCA_2D_from3D, k_values = c(3, 4, 5, 10)
)
mantel(D_2D, D_3Dsimp, permutations = 9999)
