res_2D_2Dfrom3D <- run_protest_sensitivity(
PCA_2D, PCA_2D_from3D, k_values = c(3, 4, 5, 10)
)
res_3Dsimp_3Dall <- run_protest_sensitivity(
PCA_3Dsimp, PCA_3Dall, k_values = c(3, 4, 5, 10)
)
res_3Dsimp_2Dfrom3D <- run_protest_sensitivity(
PCA_3Dsimp, PCA_2D_from3D, k_values = c(3, 4, 5, 10)
)
res_3Dall_2Dfrom3D <- run_protest_sensitivity(
PCA_3Dall, PCA_2D_from3D, k_values = c(3, 4, 5, 10)
)
mantel(D_2D, D_3Dsimp, permutations = 9999)
