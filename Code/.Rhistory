# code for plot named scatter3D_2D, modified after Kassambara, A. (2026). 3D and 4D Plots in R with the plot3D Package. Datanovia, July 12, 2026.
scatter3D_2D_from3D <- function(x, y, z, ..., colvar = NULL) {
panelfirst <- function(pmat) {
XY <- trans3D(x, y, z = rep(min(z), length(z)), pmat = pmat)
scatter2D(XY$x, XY$y, col = "darkblue", pch = ".",
cex = 2, add = TRUE, colkey = FALSE)
XY <- trans3D(x = rep(min(x), length(x)), y, z, pmat = pmat)
scatter2D(XY$x, XY$y, col = "darkblue", pch = ".",
cex = 2, add = TRUE, colkey = FALSE)
}
scatter3D(x, y, z, ..., col = "darkblue", panel.first = panelfirst,
colkey = FALSE)
}
scatter3D_2D_from3D(samples2D_from3D$PC2, samples2D_from3D$PC1, samples2D_from3D$PC3, pch = 19, cex = 1.5, bty = "g", xlab = "PC2 (19%)", ylab = "PC1 (31%)", zlab = "PC3 (13%)", ticktype = "detailed", theta = 45, phi = 20, d = 2)
plot3d(samples2D_from3D$PC1, samples2D_from3D$PC2, samples2D_from3D$PC3, clab = c("PC1", "PC2", "PC3"), col = "darkgrey", pch = 19, cex = 5, bty = "g", xlab = "PC1 (30%)", ylab = "PC2 (18%)", zlab = "PC3 (12%)")
scatter3D(x, y, z, ..., col = "darkgrey", panel.first = panelfirst,
colkey = FALSE)
# code for plot named scatter3D_2D, modified after Kassambara, A. (2026). 3D and 4D Plots in R with the plot3D Package. Datanovia, July 12, 2026.
scatter3D_2D_from3D <- function(x, y, z, ..., colvar = NULL) {
panelfirst <- function(pmat) {
XY <- trans3D(x, y, z = rep(min(z), length(z)), pmat = pmat)
scatter2D(XY$x, XY$y, col = "darkgrey", pch = ".",
cex = 2, add = TRUE, colkey = FALSE)
XY <- trans3D(x = rep(min(x), length(x)), y, z, pmat = pmat)
scatter2D(XY$x, XY$y, col = "darkgrey", pch = ".",
cex = 2, add = TRUE, colkey = FALSE)
}
scatter3D(x, y, z, ..., col = "darkgrey", panel.first = panelfirst,
colkey = FALSE)
}
scatter3D_2D_from3D(samples2D_from3D$PC2, samples2D_from3D$PC1, samples2D_from3D$PC3, pch = 19, cex = 1.5, bty = "g", xlab = "PC2 (19%)", ylab = "PC1 (31%)", zlab = "PC3 (13%)", ticktype = "detailed", theta = 45, phi = 20, d = 2)
# code for plot named scatter3D_2D, modified after Kassambara, A. (2026). 3D and 4D Plots in R with the plot3D Package. Datanovia, July 12, 2026.
scatter3D_2D_from3D <- function(x, y, z, ..., colvar = NULL) {
panelfirst <- function(pmat) {
XY <- trans3D(x, y, z = rep(min(z), length(z)), pmat = pmat)
scatter2D(XY$x, XY$y, col = "lightcoral", pch = ".",
cex = 2, add = TRUE, colkey = FALSE)
XY <- trans3D(x = rep(min(x), length(x)), y, z, pmat = pmat)
scatter2D(XY$x, XY$y, col = "lightcoral", pch = ".",
cex = 2, add = TRUE, colkey = FALSE)
}
scatter3D(x, y, z, ..., col = "lightcoral", panel.first = panelfirst,
colkey = FALSE)
}
scatter3D_2D_from3D(samples2D_from3D$PC2, samples2D_from3D$PC1, samples2D_from3D$PC3, pch = 19, cex = 1.5, bty = "g", xlab = "PC2 (19%)", ylab = "PC1 (31%)", zlab = "PC3 (13%)", ticktype = "detailed", theta = 45, phi = 20, d = 2)
plotRefToTarget(PCA_2D_from3D$shapes$shapes.comp1$min, msho2D_from3D, method = "vector")
plotRefToTarget(PCA_2D_from3D$shapes$shapes.comp1$max, msho2D_from3D, method = "vector")
plotRefToTarget(PCA_2D_from3D$shapes$shapes.comp2$min, msho2D_from3D, method = "vector")
plotRefToTarget(PCA_2D_from3D$shapes$shapes.comp2$max, msho2D_from3D, method = "vector")
plotRefToTarget(PCA_2D$shapes$shapes.comp2$min, msho2D, method = "vector")
plotRefToTarget(PCA_2D_from3D$shapes$shapes.comp2$max, msho2D_from3D, method = "vector")
plotRefToTarget(PCA_2D_from3D$shapes$shapes.comp3$min, msho2D_from3D, method = "vector")
plotRefToTarget(PCA_2D_from3D$shapes$shapes.comp3$max, msho2D_from3D, method = "vector")
