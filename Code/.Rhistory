library(geomorph)
library(ggplot2)
library(dplyr)
library("plot3D")
# Import data ----
Tilt <- readland.tps(file = "INPUT/Tilt_error.TPS", specID = "ID", readcurves = TRUE)
Tilt_df <- data.frame(name = rep(NA, dim(Tilt)[3]),
specimen = rep(NA, dim(Tilt)[3]),
orientation = rep(NA, dim(Tilt)[3]))
for (i in 1:dim(Tilt)[3]) {
Tilt_df$name[i] <- dimnames(Tilt)[[3]][i]
Tilt_df$specimen[i] <- unlist(strsplit(Tilt_df$name[i], "_"))[1]
Tilt_df$orientation[i] <- unlist(strsplit(Tilt_df$name[i], "_"))[2]
}
Tilt_df$specimen <- factor(Tilt_df$specimen)
Tilt_df$orientation <- factor(Tilt_df$orientation)
sliders_tilt <- define.sliders(3:142)
landmarks.gpaTilt <- gpagen(Tilt, curves = sliders_tilt)
plot(landmarks.gpaTilt)
PCA_Tilt <- gm.prcomp(landmarks.gpaTilt$coords)
plot(PCA_Tilt)
summary(PCA_Tilt)
PC1 <- PCA_Tilt$x[, 1]
Tilt_df$PC1 <- PC1
PC2 <- PCA_Tilt$x[, 2]
Tilt_df$PC2 <- PC2
PC3 <- PCA_Tilt$x[, 3]
Tilt_df$PC3 <- PC3
shape_dist <- data.frame()
for (l in unique(Tilt_df$specimen)) {
idx <- which(Tilt_df$specimen == l)
caudal  <- idx[Tilt_df$orientation[idx] == "caudal"]
ref     <- idx[Tilt_df$orientation[idx] == "ref"]
rostral <- idx[Tilt_df$orientation[idx] == "rostral"]
if (length(caudal) == 1 &&
length(ref) == 1 &&
length(rostral) == 1) {
shape_dist <- rbind(
shape_dist,
data.frame(
specimen = l,
comparison = "caudal-ref",
distance = D[caudal, ref]
),
data.frame(
specimen = l,
comparison = "rostral-ref",
distance = D[rostral, ref]
),
data.frame(
specimen = l,
comparison = "caudal-rostral",
distance = D[caudal, rostral]
)
)
}
}
coords <- landmarks.gpaTilt$coords
coords_2d <- two.d.array(coords)
D <- as.matrix(dist(coords_2d))
rownames(D) <- Tilt_df$name
colnames(D) <- Tilt_df$name
shape_dist <- data.frame()
for (l in unique(Tilt_df$specimen)) {
idx <- which(Tilt_df$specimen == l)
caudal  <- idx[Tilt_df$orientation[idx] == "caudal"]
ref     <- idx[Tilt_df$orientation[idx] == "ref"]
rostral <- idx[Tilt_df$orientation[idx] == "rostral"]
if (length(caudal) == 1 &&
length(ref) == 1 &&
length(rostral) == 1) {
shape_dist <- rbind(
shape_dist,
data.frame(
specimen = l,
comparison = "caudal-ref",
distance = D[caudal, ref]
),
data.frame(
specimen = l,
comparison = "rostral-ref",
distance = D[rostral, ref]
),
data.frame(
specimen = l,
comparison = "caudal-rostral",
distance = D[caudal, rostral]
)
)
}
}
shape_dist
shape_dist %>%
group_by(comparison) %>%
summarise(
mean = mean(distance),
median = median(distance),
sd = sd(distance)
)
ggplot(shape_dist,
aes(x = comparison, y = distance)) +
geom_boxplot() +
geom_jitter(width = 0.08, size = 2) +
ylab("Procrustes distance") +
xlab("") +
theme_classic()
fit <- procD.lm(
landmarks.gpaTilt$coords ~
orientation + specimen,
data = Tilt_df,
iter = 999
)
summary(fit)
idx <- Tilt_df$orientation %in% c("caudal", "ref")
fit_ca_ref <- procD.lm(
landmarks.gpaTilt$coords[, , idx] ~ orientation + specimen,
data = droplevels(Tilt_df[idx, ]),
iter = 999
)
summary(fit_ca_ref)
idx <- Tilt_df$orientation %in% c("rostral", "ref")
fit_ro_ref <- procD.lm(
landmarks.gpaTilt$coords[, , idx] ~ orientation + specimen,
data = droplevels(Tilt_df[idx, ]),
iter = 999
)
summary(fit_ro_ref)
idx <- Tilt_df$orientation %in% c("caudal", "rostral")
fit_ca_ro <- procD.lm(
landmarks.gpaTilt$coords[, , idx] ~ orientation + specimen,
data = droplevels(Tilt_df[idx, ]),
iter = 999
)
summary(fit_ca_ro)
shape_dist %>%
group_by(comparison) %>%
summarise(
mean = mean(distance),
SD = sd(distance),
median = median(distance)
)
mshape_caudal  <- mshape(coords[, , idx_caudal])
# Get specimen indices for each orientation
idx_caudal  <- which(Tilt_df$orientation == "caudal")
idx_ref     <- which(Tilt_df$orientation == "ref")
idx_rostral <- which(Tilt_df$orientation == "rostral")
# Calculate mean shapes
mshape_caudal  <- mshape(coords[, , idx_caudal])
mshape_ref     <- mshape(coords[, , idx_ref])
mshape_rostral <- mshape(coords[, , idx_rostral])
plot(mshape_caudal,
main = "Mean shape - Caudal",
asp = 1)
plot(mshape_caudal,
main = "Mean shape - Caudal",)
plot(mshape_ref,
main = "Mean shape - Ref")
plot(mshape_caudal)
plot(mshape_ref)
plot(mshape_rostral)
plot(mshape_ref)
plot(mshape_caudal)
plot(mshape_rostral)
summary(fit_ca_ro)
