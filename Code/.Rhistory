set.seed(123)
nboot <- 9999
boot_differences <- replicate(nboot, {
# Resample specimens
i <- sample(seq_len(nrow(PCA_2D$x)), replace = TRUE)
# Calculate r for each comparison
r_2D_3Dsimp <- protest(
PCA_2D$x[i, 1:3],
PCA_3Dsimp$x[i, 1:3],
permutations = 0
)$t0
r_2D_2Dfrom3D <- protest(
PCA_2D$x[i, 1:3],
PCA_2D_from3D$x[i, 1:3],
permutations = 0
)$t0
r_2D_3Dall <- protest(
PCA_2D$x[i, 1:3],
PCA_3Dall$x[i, 1:3],
permutations = 0
)$t0
# Return the three paired differences
c(
`3Dsimp - 2Dfrom3D` = r_2D_3Dsimp - r_2D_2Dfrom3D,
`3Dsimp - 3Dall`    = r_2D_3Dsimp - r_2D_3Dall,
`2Dfrom3D - 3Dall`  = r_2D_2Dfrom3D - r_2D_3Dall
)
})
# Convert to a data frame
boot_differences <- t(boot_differences)
boot_differences <- as.data.frame(boot_differences)
# 95% percentile bootstrap CIs
apply(
boot_differences,
2,
quantile,
probs = c(0.025, 0.975)
)
